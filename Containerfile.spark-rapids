FROM nvcr.io/nvidia/spark:3.5.0-rapids24.10

WORKDIR /opt/spark/work-dir

COPY spark/feature_engineering.py .
COPY spark/text_preprocessing.py .
COPY spark/embedding_generation.py .

# Install Python dependencies for UDFs
RUN pip install --no-cache-dir \
    sentence-transformers==3.3.1 \
    torch==2.5.1

USER 1001
