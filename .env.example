# Copy to .env and fill in your values. Never commit .env to git.
# Run `make setup-secrets` after filling in values to create all Kubernetes secrets.

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=http://minio.smartshop.svc.cluster.local:9000
MINIO_ENDPOINT_EXTERNAL=https://minio-s3-smartshop.apps.<cluster-domain>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis.smartshop.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=

# ── PostgreSQL (MLflow backend) ───────────────────────────────────────────────
# Use ClusterIP — OVN-K blocks cross-namespace DNS CNAME resolution from redhat-ods-applications.
# Get it with: oc get svc postgres -n smartshop -o jsonpath='{.spec.clusterIP}'
PG_USER=
PG_PASSWORD=
PG_DATABASE=mlflow
PG_CLUSTERIP=

# ── Milvus ────────────────────────────────────────────────────────────────────
MILVUS_HOST=milvus.smartshop.svc.cluster.local
MILVUS_PORT=19530

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=
HF_HOME=/tmp/hf_cache

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=https://mlflow-redhat-ods-applications.apps.<cluster-domain>/mlflow

# ── RHOAI Model Registry ──────────────────────────────────────────────────────
MODEL_REGISTRY_URL=http://model-registry-service.redhat-ods-applications.svc.cluster.local:8080

# ── Slurm ─────────────────────────────────────────────────────────────────────
SLURM_CLUSTER=slurm
SLURM_PARTITION=slinky
SLURM_NODES=2
SLURM_GPUS_PER_NODE=4

# ── KServe endpoints (set after InferenceServices are deployed) ───────────────
RECOMMEND_URL=https://smartshop-rec-smartshop.apps.<cluster-domain>/v1/models/smartshop-rec:predict
SUMMARIZE_URL=https://smartshop-llm-smartshop.apps.<cluster-domain>/v1/completions
RAG_URL=https://smartshop-rag-smartshop.apps.<cluster-domain>/v1/chat/completions
