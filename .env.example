# Copy to .env and fill in your values. Never commit .env to git.
# Run `make setup-secrets` after filling in values to create all Kubernetes secrets.

# ── Cluster / OpenShift ───────────────────────────────────────────────────────
# Your OpenShift namespace for the demo
NAMESPACE=smartshop
# Base domain of your cluster — used to build service URLs
# Get with: oc whoami --show-server | sed 's|https://api\.||;s|:6443||'
OC_CLUSTER_DOMAIN=apps.<cluster-domain>
# Default StorageClass for PVCs (Feast registry, etc.)
STORAGE_CLASS=nfs-csi
# External route for the internal image registry
# Get with: oc get route default-route -n openshift-image-registry -o jsonpath='{.spec.host}'
INTERNAL_REGISTRY=default-route-openshift-image-registry.apps.<cluster-domain>

# ── Container registry ────────────────────────────────────────────────────────
# BuildConfigs push here directly after each build.
# Images are tagged as ${REGISTRY}/smartshop-<name>:latest
REGISTRY=quay.io/<your-quay-username>
# Quay.io robot account credentials — used by make setup-push-secret and apply-all.sh phase_infra
QUAY_USER=<your-quay-username>
QUAY_TOKEN=<your-quay-robot-token>
# K8s secret name in ${NAMESPACE} holding quay.io robot account credentials.
# Create with: make setup-push-secret QUAY_USER=<user> QUAY_TOKEN=<robot-token>
QUAY_PUSH_SECRET=quay-push-secret

# ── Git source (used by BuildConfigs on the cluster) ──────────────────────────
GIT_REPO=https://github.com/<your-org>/prod-ml-demo.git
GIT_BRANCH=main

# ── Container images ──────────────────────────────────────────────────────────
# Short names resolve inside the cluster via ImageStream lookupPolicy.local.
# Once mirrored to quay.io, set full path: quay.io/<org>/smartshop-spark-jobs:latest
SPARK_JOBS_IMAGE=quay.io/<your-quay-username>/smartshop-spark-jobs:latest
# RAPIDS variant — built from build/Containerfile.spark-rapids (apache/spark base + RAPIDS JAR)
SPARK_RAPIDS_IMAGE=quay.io/<your-quay-username>/smartshop-spark-jobs-rapids:latest
# Feast server with pyspark + Hadoop-AWS JARs — built from build/Containerfile.feast-spark
FEAST_SERVER_IMAGE=quay.io/<your-quay-username>/smartshop-feast-spark-server:latest
REC_TRAINER_IMAGE=quay.io/<your-quay-username>/smartshop-rec-trainer:latest
LLM_TRAINER_IMAGE=quay.io/<your-quay-username>/smartshop-llm-trainer:latest
REC_SERVER_IMAGE=quay.io/<your-quay-username>/smartshop-rec-server:latest
RAG_SERVER_IMAGE=quay.io/<your-quay-username>/smartshop-rag-server:latest
DEMO_UI_IMAGE=quay.io/<your-quay-username>/smartshop-demo-ui:latest
# Feast Spark executor image with sentence-transformers baked in (for embedding materialization)
SPARK_EXECUTOR_EMBEDDINGS_IMAGE=quay.io/<your-quay-username>/smartshop-feast-spark-executor-embeddings:latest
# vLLM image — public DockerHub image (RHOAI registry.redhat.io image needs auth on all GPU nodes)
VLLM_IMAGE=vllm/vllm-openai:v0.13.0
# Feast executor image for RAPIDS GPU workers
FEAST_EXECUTOR_RAPIDS_IMAGE=quay.io/<your-quay-username>/smartshop-feast-spark-executor-rapids:latest

# ── Infra / utility images ───────────────────────────────────────────────────
# Spark History Server (matches ETL Spark version for DAG/metric compatibility)
SPARK_HISTORY_IMAGE=docker.io/apache/spark:3.5.3
# Grafana dashboard server
GRAFANA_IMAGE=grafana/grafana:10.4.2
# Redis Prometheus exporter
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:latest
# KServe storage initializer (used by LLM init container for LoRA adapter download)
KSERVE_STORAGE_INIT_IMAGE=registry.redhat.io/rhoai/odh-kserve-storage-initializer-rhel9@sha256:294c864d04f2ef1ba2fc2080f7eebc4d67252cce1282a46f6b416179264c8c00

# ── S3 buckets ────────────────────────────────────────────────────────────────
S3_RAW_BUCKET=smartshop-raw
S3_FEATURES_BUCKET=smartshop-features
S3_EMBEDDINGS_BUCKET=smartshop-embeddings
S3_MODELS_BUCKET=smartshop-models
S3_SPARK_LOGS_BUCKET=smartshop-spark-logs

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=http://minio.${NAMESPACE}.svc.cluster.local:9000
# External MinIO route — get after MinIO is deployed:
# oc get route minio-s3 -n smartshop -o jsonpath='{.spec.host}'
MINIO_ENDPOINT_EXTERNAL=https://minio-s3-smartshop.apps.<cluster-domain>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis.${NAMESPACE}.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=

# ── PostgreSQL (MLflow backend) ───────────────────────────────────────────────
# Use ClusterIP directly — OVN-K blocks cross-namespace DNS CNAME resolution.
# Get after postgres is deployed: oc get svc postgres -n smartshop -o jsonpath='{.spec.clusterIP}'
PG_USER=
PG_PASSWORD=
PG_DATABASE=mlflow
PG_CLUSTERIP=

# ── Milvus ────────────────────────────────────────────────────────────────────
MILVUS_HOST=milvus.${NAMESPACE}.svc.cluster.local
MILVUS_PORT=19530

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Read token from https://huggingface.co/settings/tokens (read scope is enough)
HF_TOKEN=hf_...
HF_HOME=/tmp/hf_cache

# ── MLflow ────────────────────────────────────────────────────────────────────
# RHOAI MLflow operator uses kubernetes-auth mode.
# In-cluster pods → internal SVC URL + SA bearer token (secret: smartshop-mlflow-token)
# Browser UI → https://rh-ai.apps.<cluster-domain>/mlflow/#/?workspace=<namespace>
#
# Create the SA token secret before running Spark/TrainJobs:
#   TOKEN=$(oc create token spark -n smartshop --duration=8760h)
#   oc create secret generic smartshop-mlflow-token -n smartshop \
#     --from-literal=MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc.cluster.local:8443 \
#     --from-literal=MLFLOW_TRACKING_TOKEN=$TOKEN \
#     --from-literal=MLFLOW_TRACKING_INSECURE_TLS=true \
#     --from-literal=MLFLOW_WORKSPACE=smartshop
MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc.cluster.local:8443
MLFLOW_TRACKING_INSECURE_TLS=true
MLFLOW_WORKSPACE=<your-namespace>
# Bearer token for in-cluster MLflow auth — generate once, valid for 1 year:
#   TOKEN=$(oc create token spark -n smartshop --duration=8760h)
# Then set here and run: scripts/apply-all.sh infra (creates smartshop-mlflow-token secret)
# If blank, Spark jobs still run but MLflow tracking is silently disabled.
MLFLOW_TRACKING_TOKEN=

# ── Grafana admin ────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Observability (Gradio Platform Metrics tab) ────────────────────────────────
# Grafana URL — set after deploying infrastructure/openshift/grafana.yaml
# oc get route grafana -n smartshop -o jsonpath='{.spec.host}'
GRAFANA_URL=https://grafana-smartshop.apps.<cluster-domain>
# Prometheus/Thanos URL and token for live DCGM + Redis queries in Gradio
PROMETHEUS_URL=https://thanos-querier.openshift-monitoring.svc.cluster.local:9091
# Thanos querier URLs used in Grafana datasource config
THANOS_QUERIER_URL=https://thanos-querier.openshift-monitoring.svc.cluster.local:9091
THANOS_QUERIER_UWM_URL=https://thanos-querier.openshift-monitoring.svc.cluster.local:9092
# oc sa get-token grafana-sa -n smartshop
PROMETHEUS_TOKEN=<sa-token>

# ── RHOAI Model Registry ──────────────────────────────────────────────────────
MODEL_REGISTRY_URL=http://model-registry-service.redhat-ods-applications.svc.cluster.local:8080

# ── LLM / Embedding models ────────────────────────────────────────────────────
# HuggingFace model ID for LLM fine-tuning base
LLM_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Sentence transformer model for review embeddings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Max sequence length for vLLM
MAX_MODEL_LEN=4096

# ── Model artifact paths (S3 URIs) ────────────────────────────────────────────
# Written by TrainJob, read by InferenceService at startup
MODEL_PATH=s3://smartshop-models/recommendation/best_model.pt
LLM_ADAPTER_PATH=s3://smartshop-models/llm-checkpoints/checkpoint-200
LLM_ADAPTER_S3_PREFIX=llm-checkpoints/checkpoint-200/
FEAST_REPO_PATH=/feast/feature_repo
# Registry type for training pod: remote (gRPC to feast server) or file (direct PVC)
FEAST_REGISTRY_TYPE=remote
# gRPC endpoint of feast registry server (used by rec-trainer for get_historical_features)
FEAST_REGISTRY_PATH=feast-smartshop-feast-registry.${NAMESPACE}.svc.cluster.local:6570
# Custom feast-spark-server image — same as FEAST_SERVER_IMAGE above
# Built by: oc start-build feast-spark-server -n ${NAMESPACE}
# Feast executor image — used in feast-operator.yaml for Spark-based materialization
FEAST_EXECUTOR_IMAGE=quay.io/<your-quay-username>/smartshop-feast-spark-server:latest

# ── Recommendation model training hyperparameters ─────────────────────────────
REC_MAX_ROWS=5000000
REC_TRAIN_EPOCHS=10
REC_TRAIN_BATCH_SIZE=1024
REC_TRAIN_LR=0.001
REC_EMBED_DIM=64
REC_HIDDEN_DIM=256
REC_TRAIN_NODES=2
REC_GPUS_PER_NODE=2

# ── LLM fine-tuning hyperparameters ───────────────────────────────────────────
LLM_MAX_FILES=3
LLM_MAX_STEPS=200
LLM_TRAIN_EPOCHS=3
LLM_TRAIN_BATCH_SIZE=4
LLM_GRAD_ACCUM=4
LLM_TRAIN_NODES=2
LLM_GPUS_PER_NODE=2

# ── Embedding job config ──────────────────────────────────────────────────────
# Max rows for SparkApplication embed_to_milvus.py
EMBED_MAX_ROWS=1000000

# ── Spark resource tuning ─────────────────────────────────────────────────────
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=8g
SPARK_EXECUTOR_CORES=4
SPARK_EXECUTOR_INSTANCES=4
# Embedding job needs more memory per executor (sentence-transformers model load)
SPARK_EMBED_EXECUTOR_MEMORY=16g
SPARK_EMBED_EXECUTOR_INSTANCES=8

# ── KServe replica counts ─────────────────────────────────────────────────────
REC_MIN_REPLICAS=1
REC_MAX_REPLICAS=5
LLM_MIN_REPLICAS=1
LLM_MAX_REPLICAS=3
RAG_MIN_REPLICAS=1
RAG_MAX_REPLICAS=3

# ── Slurm (optional — not currently used for training) ────────────────────────
SLURM_CLUSTER=slurm
SLURM_PARTITION=slinky
SLURM_NODES=2
SLURM_GPUS_PER_NODE=4

# ── OpenShift API ─────────────────────────────────────────────────────────────
# Used by oc login — get with: oc whoami --show-server
OCP_API_URL=https://api.<cluster-domain>:6443

# ── KServe endpoints (fill in after InferenceServices reach Ready state) ──────
# oc get ksvc -n smartshop
RECOMMEND_URL=https://smartshop-rec-smartshop.apps.<cluster-domain>/v1/models/smartshop-rec:predict
# Cluster-internal LLM URL (used by RAG pod → LLM calls inside the cluster)
LLM_URL=http://smartshop-llm-predictor.${NAMESPACE}.svc.cluster.local/v1/completions
SUMMARIZE_URL=https://smartshop-llm-smartshop.apps.<cluster-domain>/v1/completions
RAG_URL=https://smartshop-rag-smartshop.apps.<cluster-domain>/v1/ask
