# ──────────────────────────────────────────────────────────────────────
# SmartShop AI — environment template
# Copy:  cp .env.example .env
# Load:   set -a && source .env && set +a
# Mirrors _config.py and manifest envsubst placeholders.
# ──────────────────────────────────────────────────────────────────────

# ── Namespace ────────────────────────────────────────────────────────
NAMESPACE=smartshop

# ── S3 / MinIO ────────────────────────────────────────────────────────
# Notebooks/manifests: AWS_ENDPOINT_URL_S3 is also common — set it to the same URI as MINIO_ENDPOINT.
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>
AWS_DEFAULT_REGION=us-east-1
MINIO_ENDPOINT=http://minio.smartshop.svc.cluster.local:9000
AWS_ENDPOINT_URL_S3=http://minio.smartshop.svc.cluster.local:9000
S3_RAW_BUCKET=smartshop-raw
S3_FEATURES_BUCKET=smartshop-features
S3_MODELS_BUCKET=smartshop-models

# Milvus Helm (milvus-values.yaml) — often same creds as MinIO
MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_HOST=redis.smartshop.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=<your-redis-password>

# ── Milvus ─────────────────────────────────────────────────────────────
MILVUS_HOST=milvus.smartshop.svc.cluster.local
MILVUS_PORT=19530

# ── Feast (workbench + Spark driver) ───────────────────────────────────
FEAST_TLS_CERT=/etc/pki/tls/custom-certs/ca-bundle.crt

# ── HuggingFace ────────────────────────────────────────────────────────
HF_TOKEN=<your-huggingface-token>

# ── MLflow ─────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=https://mlflow-smartshop.apps.<cluster-domain>

# ── PostgreSQL (MLflow backend — mlflow-postgres apply) ────────────────
PG_USER=mlflow
PG_PASSWORD=<your-pg-password>
PG_DATABASE=mlflow

# ── Image registry base (_config.py: REGISTRY + IMAGE_TAG) ─────────────
# Push secret for OpenShift BuildConfigs output → Quay (buildconfigs.yaml)
QUAY_PUSH_SECRET=quay-push-secret
GIT_REPO=https://github.com/<org>/smartshop-ai.git
GIT_BRANCH=main

REGISTRY=quay.io/<your-org>
IMAGE_TAG=v3

# ── Feast images (tagged with IMAGE_TAG in this repo) ──────────────────
FEAST_SERVER_IMAGE=quay.io/<your-org>/smartshop-feast-spark-server:v3
FEAST_SPARK_EXECUTOR_IMAGE=quay.io/<your-org>/smartshop-feast-spark-executor:v3
FEAST_SPARK_EXECUTOR_RAPIDS_IMAGE=quay.io/<your-org>/smartshop-feast-spark-executor-rapids:v3

# ── Batch / Spark jobs (_config defaults use :latest) ─────────────────
SPARK_JOBS_IMAGE=quay.io/<your-org>/smartshop-spark-jobs:latest
SPARK_EXECUTOR_EMBEDDINGS_IMAGE=quay.io/<your-org>/smartshop-feast-spark-executor-embeddings:latest

# ── Training images (Kubeflow TrainJob / workbench) ────────────────────
REC_TRAINER_IMAGE=quay.io/<your-org>/smartshop-rec-trainer:latest
LLM_TRAINER_IMAGE=quay.io/<your-org>/smartshop-llm-trainer:latest

# ── Serving images (KServe InferenceServices) ─────────────────────────
REC_SERVER_IMAGE=quay.io/<your-org>/smartshop-rec-server:latest

# Image that runs FastAPI RAG — must include serving/rag/server.py (+ Feast + Milvus client deps).
# Default in _config is smartshop-rag-server:latest; point to REC_SERVER_IMAGE if you use one multi-purpose image.
RAG_SERVER_IMAGE=quay.io/<your-org>/smartshop-rag-server:latest

VLLM_IMAGE=vllm/vllm-openai:v0.13.0
DEMO_UI_IMAGE=quay.io/<your-org>/smartshop-demo-ui:latest

# Optional: route KServe predictor images via internal registry after local build/import, e.g.:
# REC_SERVER_IMAGE=image-registry.openshift-image-registry.svc:5000/smartshop/rec-server:latest

# ── Observability ────────────────────────────────────────────────────────
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:latest
GRAFANA_IMAGE=grafana/grafana-oss:11.6.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<set-a-strong-password>
THANOS_QUERIER_URL=https://thanos-querier.openshift-monitoring.svc:9091
THANOS_QUERIER_UWM_URL=https://thanos-querier-openshift-user-workload-monitoring.openshift-user-workload-monitoring.svc:9092
PROMETHEUS_TOKEN=<oc-sa-token-for-thanos-reader-if-required>

# Demo UI iframe / link to Grafana Route URL (HTTPS)
GRAFANA_URL=https://grafana-smartshop.apps.<cluster-domain>

# ── Model IDs & artifact paths ────────────────────────────────────────
LLM_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_PATH=s3://smartshop-models/recommendation/best_model.pt
LLM_ADAPTER_PATH=s3://smartshop-models/llm-adapter

# ── Training job parameters (e2e-notebook / notebook env) ──────────────
REC_MAX_ROWS=5000000
REC_TRAIN_EPOCHS=10
REC_TRAIN_BATCH_SIZE=2048
REC_TRAIN_NODES=1
REC_GPUS_PER_NODE=4

LLM_MAX_FILES=50
LLM_TRAIN_EPOCHS=3
LLM_MAX_STEPS=500
LLM_GRAD_ACCUM=4
LLM_TRAIN_NODES=1
LLM_GPUS_PER_NODE=4

# ── Demo UI → KServe (defaults work in-cluster; override for port-forward) ──
RECOMMEND_URL=http://smartshop-rec-predictor.smartshop.svc.cluster.local/v1/models/smartshop-rec:predict
LLM_URL=http://smartshop-llm-predictor.smartshop.svc.cluster.local/v1/completions
RAG_URL=http://smartshop-rag-predictor.smartshop.svc.cluster.local/v1/ask

# ── Storage ─────────────────────────────────────────────────────────────
STORAGE_CLASS=nfs-csi
