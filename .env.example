# S3 / MinIO Configuration
S3_ENDPOINT=http://minio.smartshop.svc.cluster.local:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=smartshop

# Feast Configuration
FEAST_REPO_PATH=feast/feature_repo
REDIS_HOST=redis.smartshop.svc.cluster.local
REDIS_PORT=6379

# Milvus (Feast Vector Store)
MILVUS_HOST=milvus.smartshop.svc.cluster.local
MILVUS_PORT=19530

# HuggingFace
HF_TOKEN=your_huggingface_token_here
HF_HOME=/tmp/hf_cache

# Model Registry
MODEL_REGISTRY_URL=http://model-registry.kubeflow.svc.cluster.local:8080

# Slurm (for LLM fine-tuning)
SLURM_CLUSTER=gpu-cluster
SLURM_PARTITION=a100
SLURM_NODES=2
SLURM_GPUS_PER_NODE=4

# KServe Endpoints
RECOMMEND_URL=http://smartshop-rec.smartshop.svc.cluster.local/v1/models/smartshop-rec:predict
SUMMARIZE_URL=http://smartshop-llm.smartshop.svc.cluster.local/v1/completions
RAG_URL=http://smartshop-rag.smartshop.svc.cluster.local/v1/chat/completions
