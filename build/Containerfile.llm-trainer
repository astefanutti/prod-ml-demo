# RHOAI training runtime — CUDA 13.0 + Python 3.12 + PyTorch 2.9.1
# Already includes: torch, transformers, peft, trl, bitsandbytes, accelerate,
# datasets, sentencepiece, deepspeed, flash-attn, xformers, mlflow, s3fs, fsspec
FROM quay.io/opendatahub/odh-th06-cuda130-torch291-py312:odh-3.4

WORKDIR /app

COPY training/llm/ training/llm/

USER 1001

CMD ["torchrun", "--nproc_per_node=1", "training/llm/finetune.py", \
     "--data-dir", "data/llm_data", "--sample"]
