FROM registry.access.redhat.com/ubi9/python-312-minimal:1

USER 0
RUN microdnf install -y gcc python3.12-devel && microdnf clean all

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_CACHE_DIR=/tmp/uv-cache

WORKDIR /app

RUN uv pip install --python python3.12 --no-cache \
    "gradio==5.23.3" \
    "jinja2>=3.1.2,<3.2" \
    requests

COPY demo/ demo/

USER 1001

EXPOSE 7860

CMD ["python", "demo/app.py"]
