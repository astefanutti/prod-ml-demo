FROM registry.access.redhat.com/ubi9/python-312-minimal:1

USER 0
RUN microdnf install -y gcc python3.12-devel && microdnf clean all

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_CACHE_DIR=/tmp/uv-cache

WORKDIR /app

COPY build/requirements/training.txt requirements.txt
RUN uv pip install --python python3.12 --no-cache -r requirements.txt

COPY training/recommendation/ training/recommendation/

USER 1001

# TrainJob overrides this CMD with --nproc_per_node=4 and actual S3 paths.
# Standalone: docker run ... --data-dir /local/features --output-dir /local/models
CMD ["torchrun", "--nproc_per_node=1", "training/recommendation/train.py", \
     "--data-dir", "data/processed", "--output-dir", "models/recommendation"]
